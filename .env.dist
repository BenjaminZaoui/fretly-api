# =============================================================
# Fichier d'exemple — fretly-api
# Copier ce fichier en .env puis remplir avec les vraies valeurs :
#   cp .env.dist .env
# Le fichier .env ne doit JAMAIS être commité (il est dans .gitignore).
# =============================================================

# Environnement d'exécution : development | staging | production
APP_ENV=development

# Clé d'API de l'application (générer une valeur aléatoire, ex. : openssl rand -hex 32)
API_KEY=changeme

# Base de données PostgreSQL
POSTGRES_USER=fretly
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fretly

# URL de connexion complète (doit reprendre les valeurs ci-dessus)
# Format : postgresql+psycopg://<utilisateur>:<mot_de_passe>@<hôte>:<port>/<base>
# En Docker Compose, l'hôte est le nom du service (ex. : db)
DATABASE_URL=postgresql+psycopg://fretly:changeme@db:5432/fretly
